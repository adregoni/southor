@page "/marketplaces"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using ST.Afiliado.Application.Marketplaces
@using ST.Afiliado.Domain.Marketplaces
@inject MarketplaceService MarketplaceService
@inject IMarketplacePersistenceStatus PersistenceStatus
@inject Microsoft.JSInterop.IJSRuntime JsRuntime

<PageTitle>Marketplaces | Southor</PageTitle>

<div class="console-shell">
    <aside class="console-sidebar">
        <a class="console-brand" href="/painel" aria-label="Southor Console"><img src="images/southor-mark.svg" alt="" /><span>SOUTHOR<span class="brand-console">CONSOLE</span></span></a>
        <button class="workspace-picker" type="button"><span class="workspace-avatar">S</span><span class="workspace-copy"><small>WORKSPACE</small><strong>Afiliados</strong></span><span aria-hidden="true">⌄</span></button>
        <nav class="sidebar-navigation" aria-label="Menu principal">
            <span class="nav-section-title">CONSOLE</span>
            <a class="sidebar-link" href="/painel"><span aria-hidden="true">▦</span><span>Visão geral</span></a>
            <span class="sidebar-link muted"><span aria-hidden="true">⬡</span><span>Ofertas</span><small>EM BREVE</small></span>
            <span class="nav-section-title nav-section-spaced">CONFIGURAÇÃO</span>
            <a class="sidebar-link active" href="/marketplaces" aria-current="page"><span aria-hidden="true">⛓</span><span>Marketplaces</span></a>
            <span class="sidebar-link muted"><span aria-hidden="true">⚙</span><span>Integrações</span><small>EM BREVE</small></span>
        </nav>
        <div class="sidebar-bottom"><div class="sidebar-help-icon">?</div><span><strong>Precisa de ajuda?</strong><small>Consulte a central de suporte</small></span></div>
    </aside>

    <div class="console-main">
        <header class="console-topbar"><div class="topbar-left"><span class="topbar-product">Southor <span>/</span> Console</span></div><div class="topbar-right"><span class="user-avatar">AR</span><span class="user-menu-copy"><strong>Anderson</strong><small>Administrador</small></span></div></header>
        <main class="dashboard-content marketplace-page">
            <div class="breadcrumbs"><a href="/painel">Console</a><span class="breadcrumb-separator">/</span><strong>Marketplaces</strong></div>
            <section class="page-heading">
                <div><span class="eyebrow">WORKSPACE / AFILIADOS</span><h1>Marketplaces</h1><p>Cadastre suas contas de afiliado para organizar a origem dos links de ofertas.</p></div>
                <button class="primary-button create-campaign-button" type="button" @onclick="StartCreate"><span aria-hidden="true">＋</span> Novo marketplace</button>
            </section>

            @if (!PersistenceStatus.IsPersistent)
            {
                <div class="persistence-notice"><strong>Modo local temporário</strong><span>Os dados ficam somente na memória e serão apagados ao reiniciar. Configure <code>MongoDb__ConnectionString</code> para persistir no MongoDB Atlas.</span></div>
            }
            @if (!string.IsNullOrWhiteSpace(_feedback)) { <div class="marketplace-feedback @(_isError ? "error" : "success")" role="status">@_feedback</div> }

            @if (_showForm)
            {
                <section class="surface-card marketplace-form-card">
                    <div class="surface-card-heading"><div><h2>@(_editingId is null ? "Novo marketplace" : "Editar marketplace")</h2><p>Informe a plataforma e os dados da sua conta de afiliado.</p></div><button class="quiet-button" type="button" @onclick="CancelForm">Fechar</button></div>
                    <EditForm Model="_form" OnValidSubmit="SaveAsync">
                        <DataAnnotationsValidator />
                        <div class="marketplace-form-grid">
                            <label>Plataforma
                                <InputSelect @bind-Value="_form.Type"><option value="">Selecione</option><option value="MercadoLivre">Mercado Livre</option><option value="Shopee">Shopee</option></InputSelect>
                                <ValidationMessage For="@(() => _form.Type)" />
                            </label>
                            <label>Nome da conta
                                <InputText @bind-Value="_form.Name" maxlength="80" placeholder="Ex.: Minha conta principal" />
                                <ValidationMessage For="@(() => _form.Name)" />
                            </label>
                            <label class="form-span-two">Código ou identificador de afiliado
                                <InputText @bind-Value="_form.AffiliateCode" maxlength="200" placeholder="Seu identificador de afiliado na plataforma" />
                                <ValidationMessage For="@(() => _form.AffiliateCode)" />
                                <small>Não informe senha nem segredo de API neste cadastro.</small>
                            </label>
                            <label class="checkbox-field form-span-two"><InputCheckbox @bind-Value="_form.IsActive" /> Conta ativa para uso em campanhas</label>
                        </div>
                        <div class="marketplace-form-actions"><button class="secondary-button form-cancel" type="button" @onclick="CancelForm">Cancelar</button><button class="primary-button" type="submit">Salvar marketplace</button></div>
                    </EditForm>
                </section>
            }

            <section class="surface-card marketplace-list-card">
                <div class="surface-card-heading"><div><h2>Contas cadastradas</h2><p>@_marketplaces.Count marketplace(s) configurado(s)</p></div><button class="quiet-button" type="button" @onclick="LoadAsync">Atualizar <span aria-hidden="true">↻</span></button></div>
                @if (_marketplaces.Count == 0)
                {
                    <div class="marketplace-empty"><span class="marketplace-empty-icon" aria-hidden="true">⌕</span><strong>Nenhum marketplace cadastrado</strong><p>Adicione uma conta do Mercado Livre ou da Shopee para começar.</p><button class="secondary-button" type="button" @onclick="StartCreate">Cadastrar marketplace</button></div>
                }
                else
                {
                    <div class="marketplace-table-wrap"><table class="marketplace-table"><thead><tr><th>PLATAFORMA</th><th>NOME DA CONTA</th><th>IDENTIFICADOR DE AFILIADO</th><th>STATUS</th><th><span class="sr-only">Ações</span></th></tr></thead><tbody>
                    @foreach (var item in _marketplaces)
                    {
                        <tr><td><span class="marketplace-platform"><span class="integration-logo @(item.Type == MarketplaceType.MercadoLivre ? "ml-logo" : "shopee-logo")">@(item.Type == MarketplaceType.MercadoLivre ? "M" : "S")</span><strong>@GetTypeName(item.Type)</strong></span></td><td>@item.Name</td><td><code>@item.AffiliateCode</code></td><td><span class="marketplace-status @(item.IsActive ? "enabled" : "disabled")"><i></i>@(item.IsActive ? "Ativo" : "Inativo")</span></td><td><div class="marketplace-row-actions"><button type="button" @onclick="() => StartEdit(item)" aria-label="Editar @item.Name">Editar</button><button type="button" class="delete-action" @onclick="() => DeleteAsync(item.Id)" aria-label="Excluir @item.Name">Excluir</button></div></td></tr>
                    }
                    </tbody></table></div>
                }
            </section>
            <footer class="dashboard-footer"><span>Southor Console <span class="footer-dot">·</span> Configuração</span><span>Ajuda <span class="footer-dot">·</span> Feedback</span></footer>
        </main>
    </div>
</div>

@code {
    private readonly FormModel _form = new();
    private List<Marketplace> _marketplaces = [];
    private Guid? _editingId;
    private bool _showForm;
    private bool _isError;
    private string? _feedback;
    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _marketplaces = (await MarketplaceService.ListAsync()).ToList();
    }

    private void StartCreate()
    {
        _editingId = null;
        _form.Type = null;
        _form.Name = string.Empty;
        _form.AffiliateCode = string.Empty;
        _form.IsActive = true;
        _showForm = true;
        _feedback = null;
    }

    private void StartEdit(Marketplace item)
    {
        _editingId = item.Id;
        _form.Type = item.Type;
        _form.Name = item.Name;
        _form.AffiliateCode = item.AffiliateCode;
        _form.IsActive = item.IsActive;
        _showForm = true;
        _feedback = null;
    }

    private async Task SaveAsync()
    {
        try
        {
            if (_form.Type is null) throw new InvalidOperationException("Selecione um marketplace.");
            if (_editingId is Guid id)
            {
                if (!await MarketplaceService.UpdateAsync(id, _form.Type.Value, _form.Name, _form.AffiliateCode, _form.IsActive))
                    throw new InvalidOperationException("Este marketplace não existe mais. Atualize a lista e tente novamente.");
            }
            else
                await MarketplaceService.CreateAsync(_form.Type.Value, _form.Name, _form.AffiliateCode, _form.IsActive);
            await LoadAsync();
            _showForm = false;
            _feedback = "Marketplace salvo com sucesso.";
            _isError = false;
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException)
        {
            _feedback = exception.Message;
            _isError = true;
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        if (!await JsRuntime.InvokeAsync<bool>("confirm", new object?[] { "Deseja excluir este marketplace?" })) return;
        if (!await MarketplaceService.DeleteAsync(id)) return;
        await LoadAsync();
        _feedback = "Marketplace excluído.";
        _isError = false;
    }

    private void CancelForm() => _showForm = false;
    private static string GetTypeName(MarketplaceType type) => type == MarketplaceType.MercadoLivre ? "Mercado Livre" : "Shopee";

    private sealed class FormModel
    {
        [Required(ErrorMessage = "Selecione uma plataforma.")]
        public MarketplaceType? Type { get; set; }
        [Required(ErrorMessage = "Informe o nome da conta.")]
        [StringLength(80, ErrorMessage = "Use até 80 caracteres.")]
        public string Name { get; set; } = string.Empty;
        [Required(ErrorMessage = "Informe o identificador de afiliado.")]
        [StringLength(200, ErrorMessage = "Use até 200 caracteres.")]
        public string AffiliateCode { get; set; } = string.Empty;
        public bool IsActive { get; set; } = true;
    }
}
